# Copy this file to .env and fill in what you need. Everything has a safe default for local use.

# ---- Core ----
# Local: SQLite file in ./data. Hosted: your Neon Postgres URL (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=
# Long random string. Signs tracking links and sessions. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me
# The address people reach LOOPX at. Used in tracking and unsubscribe links inside emails.
PUBLIC_URL=http://localhost:8000
# Anyone can create an account (as Viewer; the first account is Admin). Set false once your team has joined.
ALLOW_SIGNUP=true

# ---- Sending: console | smtp | brevo ----
# console = nothing is sent; every email is written to data/outbox/outbox.jsonl (safe for testing)
MAIL_PROVIDER=console
MAIL_FROM=reminders@yourdomain.com
MAIL_FROM_NAME=LOOPX
REPLY_TO=replies@yourdomain.com
# Brevo (free 300 emails/day, works on free hosts): brevo.com > SMTP & API > API keys
BREVO_API_KEY=
# SMTP (any provider; blocked on most free hosts, fine on your own computer)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=<16-letter app password>, and MAIL_FROM=you@gmail.com (must be the same Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
DAILY_SEND_LIMIT=300
SEND_BATCH_SIZE=50

# ---- Replies (Listener agent) - the inbox your REPLY_TO goes to ----
# Gmail: turn on 2-step verification, create an app password, use imap.gmail.com
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---- Claude (Writer drafts, Listener reading, Analyst reports, Ask LOOPX, playbook drafting) ----
# Pay-as-you-go: console.anthropic.com. Leave empty to run on rules only.
ANTHROPIC_API_KEY=
FAST_MODEL=claude-haiku-5-5
SMART_MODEL=claude-sonnet-5-5

# ---- Scheduling ----
# Secret for /cron/tick and /webhooks/brevo. Generate like SECRET_KEY.
CRON_SECRET=change-me-too
RUN_SCHEDULER=true
TICK_SECONDS=300
# Local hour after which the Timing agent builds the day's plan
PLAN_HOUR=6
# Minutes Guard waits after the test wave before checking it (use 2 while testing)
WAVE_WAIT_MINUTES=60
# Days after an email in which a purchase counts as a return
ATTRIBUTION_DAYS=7

# ---- Local demo ----
# true = create "Demo Store (local)" with 400 sample customers on first start (only @example.com addresses)
SEED_DEMO=true
